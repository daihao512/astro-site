      <div class="container nav-inner">
        <a class="brand" href="/">
          <span class="logo">L</span>
          <span>LUBAND<span class="sub">ART</span> TAPE</span>
        </a>
        <nav class="nav-links" id="nav-menu">
          <a href="/" class={path === "/" ? "active" : ""}>Home</a>
          <div class="nav-item has-dropdown">
            <a href="/products">Products <span class="caret">▾</span></a>
            <div class="dropdown mega">
              <div class="mega-col">
                <a class="mega-img" href="/products/double-sided"><img src="/products/opp.jpg" alt="Double Sided Tape" loading="lazy" /></a>
                <h3 class="mega-title"><a href="/products/double-sided">Double Sided Tape</a></h3>
