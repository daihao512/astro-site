              <div class="mega-col">
                <a class="mega-img" href="/products/foam"><img src="/products/pe-foam.jpg" alt="Foam Tape" loading="lazy" /></a>
                <h3 class="mega-title"><a href="/products/foam">Foam Tape</a></h3>
                <ul class="mega-list">
                  <li><a href="/products/pe-foam">PE Foam Tape</a></li>
                  <li><a href="/products/eva">EVA Foam Tape</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <a class="mega-img" href="/products/specialty"><img src="/products/acrylic.jpg" alt="Specialty Tape" loading="lazy" /></a>
                <h3 class="mega-title"><a href="/products/specialty">Specialty Tape</a></h3>
                <ul class="mega-list">
                  <li><a href="/products/acrylic">Acrylic Tape</a></li>
                  <li><a href="/products/low-odor">Low-Odor Tape</a></li>
                  <li><a href="/products/flame-retardant">Flame Retardant Tape</a></li>
                  <li><a href="/products/substrate-free">Substrate-Free Tape</a></li>
                </ul>
              </div>
              <div class="mega-cta">
                <h4>Custom Specs?</h4>
                <p>We engineer specific adhesive formulations for heavy-duty industrial requirements.</p>
                <a class="btn btn-quote" href="/contact">Consult an Expert</a>
              </div>
            </div>
          </div>
          <div class="nav-item has-dropdown">
            <a href="/industries">Applications <span class="caret">▾</span></a>
            <div class="dropdown apps">
              {industries.map((it) => (
                <a href={`/industries/${it.slug}`}><span class="dot"></span>{it.icon} {it.en}</a>
              ))}
              <div class="apps-foot"><a href="/industries">View All Applications →</a></div>
            </div>
          </div>
          <a href="/about">About Us</a>
          <a href="/blogs">Blogs</a>
          <a href="/contact">Contact</a>
        </nav>
        <div style="display:flex; gap:.6rem; align-items:center">
          <a class="btn btn-quote" href="/contact">Get a Quote</a>
          <button class="nav-toggle" id="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="container footer-grid">
        <div class="footer-col footer-brand">
          <div class="brand"><span class="logo">L</span> LUBANDART TAPE</div>
          <p>Industrial adhesive tape manufacturer supplying double sided tape, foam tape and specialty tape for converters, distributors and OEMs worldwide.</p>
          <div class="footer-badges">
            <span>ISO 9001</span>
            <span>RoHS</span>
            <span>REACH</span>
            <span>SGS</span>
          </div>
        </div>
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/products">Products</a></li>
            <li><a href="/industries">Applications</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/blogs">Blogs</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <ul class="footer-contact">
            <li>Email: info@lubandart.com</li>
            <li>Phone: +86 400-000-0000</li>
            <li>WhatsApp: +86 138-0000-0000</li>
          </ul>
          <div class="footer-social">
            <a href="mailto:info@lubandart.com">Email</a>
            <a href="#" rel="noopener">WhatsApp</a>
            <a href="#" rel="noopener">WeChat</a>
          </div>
        </div>
