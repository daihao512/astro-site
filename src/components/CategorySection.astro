---
import { products } from '../data/products';
import { cardCopy } from '../data/cardCopy';
import type { Category } from '../data/categories';

export interface Props {
  category: Category;
  /** Section index for alternating mod-gray / mod-light background */
  sectionIndex?: number;
}

const { category, sectionIndex = 0 } = Astro.props;
const bySlug = Object.fromEntries(products.map((p) => [p.slug, p]));
const modClass = sectionIndex % 2 === 0 ? 'mod-gray' : 'mod-light';
---

<section id={category.id} class={`mod ${modClass}`}>
  <div class="container">
    <div class="section-head cat-head">
      <div class="eyebrow">{category.index}</div>
      <h2>{category.name}</h2>
      <p>{category.intro}</p>
    </div>

    {category.alt ? (
      /* Alternating 2x2 layout for Category 03 (specialty) */
      <div class="pgrid pgrid-alt">
        {category.items.map((slug) => {
          const p = bySlug[slug];
          const c = cardCopy[p.slug];
          return (
            <a class="pcard pcard-alt" href={`/products/${p.slug}`}>
              <div class="pimg"><img src={p.img} alt={p.en} loading="lazy" /></div>
              <div class="pbody">
                <div class="ptag">{c.tag}</div>
                <h3>{p.en}</h3>
                <p class="pdesc">{c.desc}</p>
                <span class="more">View Product →</span>
              </div>
            </a>
          );
        })}
      </div>
    ) : category.items.length === 1 ? (
      /* Featured single-product layout (left text, right image) */
      <div class="pgrid pgrid-feature">
        {category.items.map((slug) => {
          const p = bySlug[slug];
          const c = cardCopy[p.slug];
          return (
            <a class="pcard pcard-feature" href={`/products/${p.slug}`}>
              <div class="pbody">
                <div class="ptag">{c.tag}</div>
                <h3>{p.en}</h3>
                <p class="pdesc">{c.desc}</p>
                <span class="more">View Product →</span>
              </div>
              <div class="pimg pimg-side"><img src={p.img} alt={p.en} loading="lazy" /></div>
            </a>
          );
        })}
      </div>
    ) : (
      /* Default grid layout for multi-product categories */
      <div class="pgrid">
        {category.items.map((slug) => {
          const p = bySlug[slug];
          const c = cardCopy[p.slug];
          return (
            <a class="pcard" href={`/products/${p.slug}`}>
              <div class="pimg"><img src={p.img} alt={p.en} loading="lazy" /></div>
              <div class="pbody">
                <div class="ptag">{c.tag}</div>
                <h3>{p.en}</h3>
                <p class="pdesc">{c.desc}</p>
                <span class="more">View Product →</span>
              </div>
            </a>
          );
        })}
      </div>
    )}

    <div class="cat-foot">
      <a class="btn btn-ghost" href="/contact">Request a Quote for {category.name} →</a>
    </div>
  </div>
</section>

<style>
  .cat-head { display: flex; flex-direction: column; align-items: flex-start; text-align: left; max-width: 900px; margin: 0 0 2.6rem; }
  .cat-head .eyebrow { display: inline-block; margin-bottom: 1rem; }
  .cat-head h2 { font-size: clamp(1.6rem, 3.2vw, 2.4rem); margin: 0 0 1rem; }
  .cat-head p { text-align: left; max-width: 760px; margin: 0; color: var(--fg-soft); font-size: 1rem; line-height: 1.65; }

  .pgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.6rem; }
  .pcard { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; color: inherit; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .pcard:hover { transform: translateY(-6px); border-color: var(--accent); box-shadow: var(--shadow); }
  .pimg { aspect-ratio: 4 / 3; overflow: hidden; background: #e6e6e0; }
  .pimg img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .pcard:hover .pimg img { transform: scale(1.06); }
  .pbody { padding: 1.5rem 1.6rem 1.7rem; display: flex; flex-direction: column; flex: 1; }
  .ptag { font-size: .76rem; color: var(--accent); font-weight: 600; letter-spacing: .3px; text-transform: uppercase; margin-bottom: .5rem; }
  .pbody h3 { font-size: 1.15rem; margin: 0 0 .6rem; color: var(--fg); letter-spacing: .5px; }
  .pdesc { color: var(--fg-soft); font-size: .92rem; line-height: 1.6; margin: 0 0 1rem; flex: 1; }
  .pbody .more { color: var(--accent); font-family: var(--font-head); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; font-size: .82rem; }
  .cat-foot { margin-top: 2.4rem; }

  /* Featured single-product layout */
  .pgrid-feature { display: block; }
  .pcard-feature { display: grid; grid-template-columns: 1fr 1.05fr; background: #fff; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; max-width: 1000px; margin: 0 auto; flex-direction: row; color: inherit; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .pcard-feature:hover { transform: translateY(-6px); border-color: var(--accent); box-shadow: var(--shadow); }
  .pcard-feature .pbody { padding: 2.2rem 2.4rem; display: flex; flex-direction: column; justify-content: center; flex: 1; order: 1; }
  .pcard-feature .pimg-side { aspect-ratio: 1 / 1; background: #fff; overflow: hidden; max-height: 440px; order: 2; }
  .pcard-feature .pimg-side img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .pcard-feature:hover .pimg-side img { transform: scale(1.04); }
  .pcard-feature .ptag { margin-bottom: .7rem; }
  .pcard-feature .pbody h3 { font-size: 1.4rem; margin: .2rem 0 .8rem; color: var(--fg); letter-spacing: .5px; }
  .pcard-feature .pdesc { font-size: .94rem; line-height: 1.7; margin: 0 0 1.2rem; color: var(--fg-soft); }
  @media (max-width: 760px) {
    .pcard-feature { grid-template-columns: 1fr; }
    .pcard-feature .pbody { order: 2; padding: 1.6rem 1.7rem; }
    .pcard-feature .pimg-side { order: 1; aspect-ratio: 4 / 3; max-height: 320px; }
    .pcard-feature .pbody h3 { font-size: 1.2rem; }
  }

  /* Alternating 2x2 layout */
  .pgrid-alt { grid-template-columns: 1fr 1fr; }
  .pcard-alt { display: grid; grid-template-columns: 1fr 1.05fr; flex-direction: row; }
  .pcard-alt .pimg { order: 1; aspect-ratio: 1 / 1; max-height: 360px; }
  .pcard-alt .pbody { order: 2; padding: 1.5rem 1.7rem; justify-content: center; }
  .pcard-alt .pbody h3 { font-size: 1.1rem; }
  .pcard-alt .pdesc { font-size: .9rem; line-height: 1.6; }
  .pcard-alt:nth-child(even) .pimg { order: 2; }
  .pcard-alt:nth-child(even) .pbody { order: 1; }
  @media (max-width: 860px) {
    .pgrid-alt { grid-template-columns: 1fr; }
    .pcard-alt, .pcard-alt:nth-child(even) { grid-template-columns: 1fr; }
    .pcard-alt .pimg, .pcard-alt:nth-child(even) .pimg { order: 1; aspect-ratio: 4 / 3; max-height: 280px; }
    .pcard-alt .pbody, .pcard-alt:nth-child(even) .pbody { order: 2; padding: 1.3rem 1.5rem; }
  }
</style>
