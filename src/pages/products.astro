---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';

const cats = [
  { name: "泡棉基材", note: "缓冲 · 密封 · 减震", items: ["pe-foam", "eva"] },
  { name: "薄膜基材", note: "薄型 · 精密 · 稳定", items: ["pet", "pvc", "opp"] },
  { name: "高性能胶系", note: "强粘 · 耐候 · 复合", items: ["acrylic", "tissue"] },
];
const bySlug = Object.fromEntries(products.map((p) => [p.slug, p]));
---

<Layout title="产品中心 — LubandArt Tape" description="双面亚克力胶、EVA、OPP、PE 泡棉、PET、PVC、棉纸双面胶 7 大系列，覆盖多场景粘接需求。">
  <!-- 页头 -->
  <section style="background:var(--bg-soft); padding:4rem 0 2.5rem">
    <div class="container">
      <div class="eyebrow">Products</div>
      <h1 class="page-title">产品中心</h1>
      <p class="page-sub">覆盖多场景的胶粘产品矩阵，支持按规格、基材与用途定制。点击任意产品查看完整规格与应用。</p>
    </div>
  </section>

  <!-- 分类导览 -->
  <section style="padding:2.5rem 0">
    <div class="container">
      <div class="cat-nav">
        {cats.map((c) => (
          <div class="cat-pill">
            <strong>{c.name}</strong>
            <span>{c.note}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 产品列表 -->
  <section style="padding:1.5rem 0 5rem">
    <div class="container">
      <div class="grid">
        {products.map((p) => (
          <a class="card product-card" href={`/products/${p.slug}`}>
            <img src={p.img} alt={p.en} class="product-img" loading="lazy" />
            <h3>{p.name}</h3>
            <p class="en">{p.en}</p>
            <p class="tagline">{p.tagline}</p>
            <p class="desc">{p.intro.slice(0, 46)}…</p>
            <span class="more">查看详情 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .5rem 0 .6rem; }
  .page-sub { color: var(--fg-soft); max-width: 640px; }
  .eyebrow { color: var(--accent); font-weight: 700; letter-spacing: 2px; font-size: .8rem; text-transform: uppercase; }
  .cat-nav { display: flex; flex-wrap: wrap; gap: .8rem; }
  .cat-pill { border: 1px solid var(--line); border-radius: 999px; padding: .5rem 1rem; display: flex; flex-direction: column; line-height: 1.3; }
  .cat-pill strong { font-size: .95rem; }
  .cat-pill span { font-size: .78rem; color: var(--fg-soft); }

  .product-card { display: block; color: inherit; }
  .product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--accent); }
  .product-img { width: 100%; height: 170px; object-fit: cover; border-radius: 12px; margin-bottom: 1rem; background: var(--bg-soft); }
  .product-card .en { color: var(--accent); font-size: .8rem; font-weight: 600; letter-spacing: .3px; margin: -.3rem 0 .4rem; }
  .product-card .tagline { color: var(--fg); font-weight: 600; font-size: .9rem; margin: 0 0 .4rem; }
  .product-card .desc { color: var(--fg-soft); font-size: .9rem; margin: 0 0 .8rem; }
  .product-card .more { color: var(--accent); font-weight: 600; font-size: .88rem; }
</style>
