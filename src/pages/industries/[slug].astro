---
import Layout from '../../layouts/Layout.astro';
import { industries } from '../../data/industries';
import { products } from '../../data/products';

export function getStaticPaths() {
  return industries.map((it) => ({ params: { slug: it.slug } }));
}

const { slug } = Astro.params;
const industry = industries.find((it) => it.slug === slug);
if (!industry) return Astro.redirect("/industries");

const recommendMap: Record<string, string[]> = {
  automotive: ["acrylic", "pe-foam", "tissue"],
  construction: ["pe-foam", "acrylic", "pvc"],
  appliance: ["pe-foam", "eva", "pet"],
  machinery: ["acrylic", "pe-foam", "opp"],
  signage: ["acrylic", "pet", "tissue"],
  electronics: ["pet", "acrylic", "tissue"],
};
const recommended = (recommendMap[industry.slug] ?? [])
  .map((s) => products.find((p) => p.slug === s))
  .filter(Boolean);
---

<Layout title={`${industry.name}行业方案 — LubandArt Tape`} description={industry.desc}>
  <div class="container" style="padding-top:1.5rem">
    <nav class="crumbs"><a href="/">首页</a> / <a href="/industries">行业方案</a> / <span>{industry.name}</span></nav>
  </div>

  <section style="background:var(--bg-soft); padding:2rem 0">
    <div class="container ind-head">
      <div class="ind-ico">{industry.icon}</div>
      <div>
        <div class="eyebrow">{industry.en}</div>
        <h1 class="ind-title">{industry.name}行业解决方案</h1>
        <p class="ind-desc">{industry.desc}</p>
      </div>
    </div>
  </section>

  <section style="padding:4rem 0">
    <div class="container">
      <div class="section-head" style="text-align:left; margin:0 0 2rem">
        <div class="eyebrow">Solutions</div>
        <h2>我们的方案</h2>
      </div>
      <div class="grid sols">
        {industry.solutions.map((s, i) => (
          <div class="card sol-card"><div class="dot">{i + 1}</div><p>{s}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--bg-soft); padding:4rem 0">
    <div class="container">
      <div class="section-head" style="text-align:left; margin:0 0 2rem">
        <div class="eyebrow">Recommended</div>
        <h2>推荐产品</h2>
      </div>
      <div class="grid">
        {recommended.map((r) => (
          <a class="card rec-card" href={`/products/${r!.slug}`}>
            <img src={r!.img} alt={r!.en} class="rec-img" loading="lazy" />
            <h3>{r!.name}</h3>
            <p class="en">{r!.en}</p>
            <p class="tagline">{r!.tagline}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:2rem"><a class="btn" href="/contact">为该行业定制方案 →</a></p>
    </div>
  </section>
</Layout>

<style>
  .crumbs { font-size: .85rem; color: var(--fg-soft); }
  .crumbs a { color: var(--fg-soft); } .crumbs a:hover { color: var(--accent); }
  .eyebrow { color: var(--accent); font-weight: 700; letter-spacing: 2px; font-size: .8rem; text-transform: uppercase; }
  .ind-head { display: grid; grid-template-columns: auto 1fr; gap: 1.8rem; align-items: center; }
  .ind-ico { width: 84px; height: 84px; border-radius: 20px; background: rgba(246,130,31,.12); display: grid; place-items: center; font-size: 2.6rem; }
  .ind-title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: .4rem 0 .5rem; }
  .ind-desc { color: var(--fg-soft); line-height: 1.7; max-width: 720px; }
  .sols { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .sol-card { display: flex; gap: 1rem; align-items: flex-start; }
  .sol-card .dot { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px; background: var(--accent); color: #fff; display: grid; place-items: center; font-weight: 800; }
  .sol-card p { margin: 0; }
  .rec-card { color: inherit; }
  .rec-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--accent); }
  .rec-img { width: 100%; height: 150px; object-fit: cover; border-radius: 12px; margin-bottom: .8rem; }
  .rec-card .en { color: var(--accent); font-size: .78rem; font-weight: 600; margin: -.2rem 0 .3rem; }
  .rec-card .tagline { color: var(--fg-soft); font-size: .88rem; margin: 0; }
  @media (max-width: 600px) { .ind-head { grid-template-columns: 1fr; text-align: center; } .ind-ico { margin: 0 auto; } }
</style>
