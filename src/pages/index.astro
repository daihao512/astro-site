---
import Layout from '../layouts/Layout.astro';
import { industries } from '../data/industries';
import { SITE, absUrl } from '../config/site';
import FaqSection from '../components/FaqSection.astro';

/* WebSite structured data — helps search engines understand the site root */
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: { '@id': absUrl('/#organization') },
};

/* representative product image per industry (industries.img is empty by design) */
const indImg: Record<string, string> = {
  automotive: '/products/acrylic.jpg',
  construction: '/products/pe-foam.jpg',
  appliance: '/products/pvc.jpg',
  machinery: '/products/acrylic.jpg',
  signage: '/products/acrylic.jpg',
  electronics: '/products/pet.jpg',
};
---

<Layout title="LubandArt Tape — Industrial Double Sided, Foam & Specialty Tape Supplier" jsonLd={websiteLd}>
  <!-- ====== HERO — full-screen, video background with graceful gradient fallback ====== -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <!-- Use the gradient hero until a real, compressed company asset is supplied. -->
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-grid container">
      <div class="hero-copy">
        <span class="hero-tag">INDUSTRIAL ADHESIVE SOLUTIONS</span>
        <h1 class="hero-title">
          <span class="line">Double Sided <span class="hl">Tape</span> · Foam <span class="hl">Tape</span> ·</span>
          <span class="line">Specialty <span class="hl">Tape</span> Supplier</span>
        </h1>
        <p class="hero-sub">Industrial adhesive solutions for converting, distribution and manufacturing — specified for the surfaces, dimensions and service conditions in your project.</p>
        <div class="hero-cta">
          <a class="btn" href="/products">Explore Products</a>
          <a class="btn btn-ghost-light" href="/contact">Get a Quote</a>
        </div>
      </div>
      <div class="data-bar">
          <div><strong>Quality Management</strong><span>Certification documents available on request</span></div>
          <div><strong>Industrial Adhesives</strong><span>Application-focused supply</span></div>
          <div><strong>Global Supply</strong><span>Export support for B2B orders</span></div>
      </div>
    </div>
  </section>

  <!-- ====== WHO WE SERVE (icon cards) ====== -->
  <section class="mod mod-light">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">PARTNERS</div>
        <h2>Who We <span class="accent">Serve</span></h2>
        <p>Reliable adhesive supply for every link of the value chain — from converters and distributors to large-scale OEMs.</p>
      </div>
      <div class="icon-grid">
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="24" r="11"/><circle cx="30" cy="24" r="11"/><line x1="7" y1="24" x2="41" y2="24"/></svg>
          </div>
          <h3>Converters</h3>
          <p>Die-cutting and slitting partners relying on consistent, convert-ready rolls with tight tolerance.</p>
          <span class="more">Talk to Engineering →</span>
        </article>
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="14" width="22" height="16" rx="1"/><path d="M28 20h8l6 6v4H28z"/><circle cx="15" cy="34" r="3"/><circle cx="35" cy="34" r="3"/></svg>
          </div>
          <h3>Distributors</h3>
          <p>Wholesalers sourcing a broad tape portfolio with stable quality and flexible MOQ for every market.</p>
          <span class="more">View Catalog →</span>
        </article>
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 38V20l10 7V20l10 7V20l12 8v10z"/><line x1="8" y1="38" x2="40" y2="38"/></svg>
          </div>
          <h3>OEM Manufacturers</h3>
          <p>Factories integrating our tapes into final products through OEM and ODM programs.</p>
          <span class="more">Start OEM Project →</span>
        </article>
      </div>
    </div>
  </section>

  <!-- ====== CORE PRODUCTS (local images) ====== -->
  <section class="mod mod-gray">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">PRODUCTS</div>
        <h2>Core <span class="accent2">Products</span></h2>
        <p>Three families engineered for demanding industrial bonding — manufactured in-house from coating to finished roll.</p>
      </div>
      <div class="featured-layout">
        <article class="featured-card feature-big reveal">
          <div class="img-wrap"><img src="/products/acrylic.jpg" alt="Double Sided Tape" loading="lazy" /></div>
          <div class="body">
            <span class="tag">01 / DOUBLE SIDED</span>
            <h3>Double Sided Tape</h3>
            <p>Acrylic, PET, tissue and OPP carriers for permanent, invisible bonding across surfaces — engineered for high-temperature, UV-resistant and structural demands.</p>
            <a href="/products/double-sided" class="more">Learn More →</a>
          </div>
        </article>
        <div class="featured-side">
          <article class="featured-card reveal">
            <div class="img-wrap"><img src="/products/pe-foam.jpg" alt="Foam Tape" loading="lazy" /></div>
            <div class="body">
              <span class="tag">02 / FOAM</span>
              <h3>Foam Tape</h3>
              <p>PE and EVA foam tapes that absorb shock, seal gaps and fill uneven surfaces for mounting and weatherstripping.</p>
              <a href="/products/foam" class="more">Learn More →</a>
            </div>
          </article>
          <article class="featured-card reveal">
            <div class="img-wrap"><img src="/products/pvc.jpg" alt="Specialty Tape" loading="lazy" /></div>
            <div class="body">
              <span class="tag">03 / SPECIALTY</span>
              <h3>Specialty Tape</h3>
              <p>High-temperature, flame-retardant and structural tapes for critical applications in transport, energy and electronics.</p>
              <a href="/products/specialty" class="more">Learn More →</a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== APPLICATIONS — driven by src/data/industries (same source as the nav) ====== -->
  <section class="mod mod-light">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">INDUSTRIES</div>
        <h2>Application <span class="accent">Areas</span></h2>
        <p>Application references across six major industries — use the project brief and sample test to confirm the required durability and precision.</p>
      </div>
      <div class="zigzag">
        {industries.map((it, i) => (
          <div class={`zig-row ${i % 2 === 1 ? 'reverse' : ''} reveal`}>
            <div class="zig-img"><img src={indImg[it.slug]} alt={it.en} loading="lazy" /></div>
            <div class="zig-text">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{it.icon} {it.en}</h3>
              <p>{it.descEn}</p>
              <a href={`/industries/${it.slug}`} class="explore">Explore {it.en} →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== CAPABILITIES (icon cards) ====== -->
  <section class="mod mod-gray">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">IN-HOUSE</div>
        <h2>Our <span class="accent2">Capabilities</span></h2>
        <p>Vertical integration from adhesive coating to finished roll — every process under one roof, controlled and traceable.</p>
      </div>
      <div class="icon-grid icon-grid-4">
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><rect x="10" y="10" width="20" height="8" rx="2"/><line x1="30" y1="14" x2="38" y2="14"/><line x1="20" y1="18" x2="20" y2="34"/><line x1="12" y1="34" x2="28" y2="34"/></svg>
          </div>
          <h3>Coating</h3>
          <p>Precision adhesive coating on varied carriers with controlled thickness and uniform coverage.</p>
        </article>
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M38 24a14 14 0 1 1-4-10"/><path d="M38 6v10h-10"/></svg>
          </div>
          <h3>Rewinding</h3>
          <p>Rewinding to custom lengths and roll configurations for clean, ready-to-use delivery.</p>
        </article>
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 40L36 12"/><path d="M30 10h10v10"/></svg>
          </div>
          <h3>Slitting</h3>
          <p>Narrow slitting to exact widths with burr-free, consistent edges for downstream converting.</p>
        </article>
        <article class="icon-card reveal">
          <div class="ico">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><circle cx="14" cy="14" r="5"/><circle cx="14" cy="34" r="5"/><path d="M18 17L38 34M18 31L38 14"/></svg>
          </div>
          <h3>Die-Cutting</h3>
          <p>Custom shapes and pads cut to drawing for ready-to-assemble parts and OEM integration.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ====== WHY WORK WITH US (light) ====== -->
  <section class="mod mod-gray">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">TRUST</div>
        <h2>Why Work <span class="accent">With Us</span></h2>
        <p>Quality documents, application review and production coordination to support a repeatable B2B supply decision.</p>
      </div>
      <div class="trust-grid">
        <div class="trust reveal">
          <div class="trust-ico">🏅</div>
          <h3>Certifications</h3>
          <p>Certification and selected product test documents can be provided for review against the requested grade.</p>
          <div class="trust-badges"><span>DOCUMENTS</span><span>TEST DATA</span></div>
        </div>
        <div class="trust reveal">
          <div class="trust-ico">🌐</div>
          <h3>Global Reach</h3>
          <p>Supporting international buyers with stable export and logistics coordination.</p>
          <div class="trust-num">GLOBAL</div>
        </div>
        <div class="trust reveal">
          <div class="trust-ico">🎯</div>
          <h3>Quality Control</h3>
          <p>Quality checks can be matched to the agreed product specification and test plan.</p>
          <div class="trust-num">QC</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== GET A QUOTE ====== -->
  <section class="mod mod-light">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">START</div>
        <h2>Get a <span class="accent">Quote</span></h2>
        <p>Tell us your requirement and our engineering team will review the specification and reply with product recommendations and pricing.</p>
      </div>
      <div class="contact-grid">
        <form id="homeQuoteForm" class="quote-form">
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-trap" />
          <div class="row">
            <input type="text" name="name" placeholder="Your Name" aria-label="Your name" autocomplete="name" required />
            <input type="email" name="email" placeholder="Email Address *" aria-label="Email address" autocomplete="email" required />
          </div>
          <input type="text" name="company" placeholder="Company Name" aria-label="Company name" autocomplete="organization" />
          <div class="row">
            <input type="text" name="spec" placeholder="Width / thickness / length" aria-label="Width, thickness and length" />
            <input type="text" name="quantity" placeholder="Estimated quantity" aria-label="Estimated quantity" />
          </div>
          <select name="product" aria-label="Product requirement">
            <option value="">Product Requirement</option>
            <option>Double Sided Tape</option>
            <option>Foam Tape</option>
            <option>Specialty Tape</option>
            <option>Custom / OEM Project</option>
          </select>
          <textarea name="message" placeholder="Application, substrate, target market, sample or OEM needs…" aria-label="Application and requirements"></textarea>
          <button class="btn" type="submit">Submit Inquiry</button>
          <p id="homeQuoteStatus" class="quote-status" role="status" aria-live="polite"></p>
        </form>
        <div>
          <ul class="info-list">
            <li><strong>Email</strong><span>info@lubandart.com</span></li>
            <li><strong>Contact</strong><span>Email or WhatsApp available on request</span></li>
            <li><strong>Location</strong><span>Guangdong, China</span></li>
          </ul>
          <p class="quote-hint">Need to send a drawing or spec sheet? Email it to info@lubandart.com with your inquiry details.</p>
        </div>
      </div>
    </div>
  </section>
<FaqSection title="Buying Industrial Tape: Frequently Asked Questions" intro="Common questions buyers ask before requesting samples or a quotation." items={[
  { q: 'What information should I send for a tape recommendation?', a: 'Send the substrate, application area, target width and thickness, service temperature, estimated quantity and whether you need rolls or die-cut parts.' },
  { q: 'Can LubandArt customize tape constructions and packaging?', a: 'Yes. Adhesive system, carrier, thickness, width, roll length, liner, core, die-cut shape, labels and export packaging can be discussed against the project requirement.' },
  { q: 'Can I request samples before placing an order?', a: 'Yes. Sample availability and preparation time are confirmed against the requested construction. Testing the actual substrate and assembly is recommended before production approval.' },
  { q: 'How are MOQ and lead time confirmed?', a: 'MOQ and lead time depend on construction, converting method, packaging and quantity. They are confirmed in the quotation after the specification is locked.' },
  { q: 'Which certificates and reports can be provided?', a: 'Available documents may include ISO 9001, RoHS, REACH and selected product test reports, depending on the product grade and project requirement.' },
]} />
</Layout>

<script>
  const homeForm = document.getElementById('homeQuoteForm');
  const homeStatus = document.getElementById('homeQuoteStatus');
  const homeButton = homeForm?.querySelector('button[type="submit"]');
  homeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!homeStatus) return;
    const form = event.currentTarget;
    const data = Object.fromEntries(new FormData(form).entries());
    homeStatus.className = 'quote-status';
    homeStatus.textContent = 'Submitting…';
    if (homeButton) homeButton.disabled = true;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15000);
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: controller.signal,
      });
      window.clearTimeout(timeout);
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok || result.degraded) {
        throw new Error(result.degraded
          ? 'Inquiry service is being configured. Please email us directly.'
          : (result.error || 'Submission failed.'));
      }
      homeStatus.className = 'quote-status ok';
      homeStatus.textContent = '✓ Inquiry received. We will contact you shortly.';
      form.reset();
    } catch (error) {
      homeStatus.className = 'quote-status err';
      homeStatus.textContent = error instanceof DOMException && error.name === 'AbortError'
        ? '✗ The request timed out. Please email us directly.'
        : '✗ Network error. Please email us directly.';
    } finally {
      if (homeButton) homeButton.disabled = false;
    }
  });
</script>

<style>
  /* ============================================================
     HERO — full-screen, video background with graceful gradient fallback
     ============================================================ */
  .hero {
    position: relative; overflow: hidden; background: #0e0e10;
    min-height: 100svh; display: flex; align-items: center; justify-content: center;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(900px 480px at 82% -8%, rgba(200,84,43,.26), transparent 60%),
      radial-gradient(680px 420px at 8% 110%, rgba(200,84,43,.10), transparent 60%),
      linear-gradient(135deg, #141316 0%, #1b1816 55%, #0e0e10 100%);
  }
  .hero-bg::before {
    content: ""; position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at 50% 35%, #000 0%, transparent 78%);
    -webkit-mask-image: radial-gradient(circle at 50% 35%, #000 0%, transparent 78%);
  }
  .hero-video { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg, rgba(14,14,16,.55) 0%, rgba(14,14,16,.30) 45%, rgba(14,14,16,.80) 100%);
  }
  .hero-grid {
    position: relative; z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
    padding: 5rem 1.5rem; max-width: var(--maxw); width: 100%;
  }
  .hero-copy { max-width: 980px; margin: 0 auto; text-align: center; }
  .hero-tag {
    display: inline-block; color: #fff;
    font-family: var(--font-head); font-size: .82rem; font-weight: 600; letter-spacing: 4px;
    text-transform: uppercase; padding: .55rem 1.2rem;
    border: 1px solid rgba(255,255,255,.25); margin: 0 auto 1.8rem; background: rgba(0,0,0,.25);
  }
  .hero-title {
    font-family: var(--font-head); font-size: clamp(2.2rem, 5.4vw, 4.8rem); font-weight: 700;
    line-height: 1.08; letter-spacing: 1px; text-transform: uppercase; color: #fff; margin: 0 auto 1.4rem;
    text-wrap: balance;
  }
  .hero-title .line { display: block; }
  .hero-title .hl { color: var(--accent); }
  @media (min-width: 760px) { .hero-title .line { white-space: nowrap; } }
  .hero-sub { font-size: 1.12rem; color: #e6e6e6; max-width: 60ch; margin: 0 auto 2.2rem; line-height: 1.65; }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  .btn-ghost-light { background: transparent; color: #fff; border: 2px solid #fff; }
  .btn-ghost-light:hover { background: #fff; color: var(--bg-3); }
  .data-bar {
    position: relative; z-index: 3;
    display: flex; gap: 2.5rem; flex-wrap: wrap; justify-content: center;
    border-top: 1px solid rgba(255,255,255,.14); padding: 1.6rem 1.5rem 2.4rem; max-width: var(--maxw); width: 100%; margin: 0 auto;
  }
  .data-bar > div { display: flex; flex-direction: column; align-items: center; min-width: 200px; position: relative; padding-top: .8rem; }
  .data-bar > div::before { content: ""; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 36px; height: 3px; background: var(--accent); border-radius: 2px; }
  .data-bar strong { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 1px; color: #fff; font-size: 1.02rem; text-align: center; }
  .data-bar span { color: #b8b8b8; font-size: .76rem; letter-spacing: .5px; text-transform: uppercase; text-align: center; }

  /* ============================================================
     ICON CARDS (Who We Serve / Capabilities) — inline SVG, no images
     ============================================================ */
  .icon-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.8rem; }
  .icon-grid-4 { grid-template-columns: repeat(4, 1fr); }
  .icon-card {
    background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg); padding: 2rem 1.8rem 2.2rem;
    transition: transform .25s, box-shadow .25s, border-color .25s; display: flex; flex-direction: column;
  }
  .icon-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: var(--accent); }
  .icon-card .ico {
    width: 64px; height: 64px; display: grid; place-items: center; margin-bottom: 1.2rem;
    background: rgba(200,84,43,.10); color: var(--accent); border: 1px solid rgba(200,84,43,.28); border-radius: 10px;
  }
  .icon-card .ico svg { width: 34px; height: 34px; }
  .icon-card h3 { font-size: 1.3rem; margin: 0 0 .6rem; color: var(--fg); }
  .icon-card p { color: var(--fg-soft); font-size: .94rem; margin: 0 0 1.2rem; line-height: 1.65; flex: 1; }
  .icon-card .more { font-family: var(--font-head); font-weight: 700; font-size: .78rem; letter-spacing: 1.2px; text-transform: uppercase; color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: .15rem; align-self: flex-start; }

  /* ============================================================
     CORE PRODUCTS — featured offset layout
     ============================================================ */
  .featured-layout { display: grid; grid-template-columns: 1.35fr 1fr; gap: 1.8rem; align-items: stretch; }
  .featured-card {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden;
    transition: transform .25s, box-shadow .25s, border-color .25s; display: flex; flex-direction: column; position: relative; height: 100%;
  }
  .featured-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: var(--accent); }
  .featured-card .img-wrap { overflow: hidden; background: #d8d8d4; }
  .featured-card .img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .featured-card:hover .img-wrap img { transform: scale(1.06); }
  .featured-card .body { padding: 1.8rem 2rem 2rem; display: flex; flex-direction: column; flex: 1; }
  .featured-card .tag { font-family: var(--font-head); font-size: .78rem; color: var(--accent); letter-spacing: 2px; font-weight: 600; display: inline-block; margin-bottom: .6rem; }
  .featured-card h3 { font-size: 1.6rem; margin: 0 0 .7rem; color: var(--fg); }
  .featured-card.feature-big h3 { font-size: 1.9rem; }
  .featured-card p { color: var(--fg-soft); font-size: .96rem; line-height: 1.7; flex: 1; }
  .featured-card .more { margin-top: 1.3rem; align-self: flex-start; font-family: var(--font-head); font-weight: 700; font-size: .82rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: .2rem; }
  .featured-card.feature-big .img-wrap { aspect-ratio: 16 / 10; }
  .featured-side { display: grid; grid-template-rows: 1fr 1fr; gap: 1.8rem; }
  .featured-side .featured-card .img-wrap { aspect-ratio: 16 / 7; }
  .featured-side .featured-card .body { padding: 1.5rem 1.6rem 1.6rem; }

  /* ============================================================
     APPLICATIONS — zigzag, local images
     ============================================================ */
  .zigzag { display: flex; flex-direction: column; gap: 5rem; }
  .zig-row { display: grid; grid-template-columns: 1.15fr 1fr; gap: 4rem; align-items: center; }
  .zig-row.reverse { grid-template-columns: 1fr 1.15fr; }
  .zig-img { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 5 / 4; box-shadow: var(--shadow-lg); }
  .zig-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .zig-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(200,84,43,.10), transparent 60%); pointer-events: none; }
  .zig-row:hover .zig-img img { transform: scale(1.05); }
  .zig-row.reverse .zig-img { order: 2; }
  .zig-row.reverse .zig-text { order: 1; }
  .zig-text .num { font-family: var(--font-head); font-size: 1.5rem; color: var(--accent); display: block; font-weight: 700; margin-bottom: .4rem; letter-spacing: 2px; }
  .zig-text h3 { font-size: 1.9rem; margin: 0 0 1rem; color: var(--fg); }
