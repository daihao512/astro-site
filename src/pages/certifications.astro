---
import Layout from '../layouts/Layout.astro';
import SubHero from '../components/SubHero.astro';

const certs = [
  { icon: "📜", name: "ISO 9001:2015", desc: "Quality Management System certification covering R&D, production and quality control across the full process.", file: "/certs/iso-9001.pdf" },
  { icon: "♻️", name: "RoHS Compliance", desc: "Materials meet the Restriction of Hazardous Substances directive. Test reports are available for download.", file: "/certs/rohs.pdf" },
  { icon: "🌿", name: "REACH Compliance", desc: "Compliant with REACH registration, evaluation and authorization requirements for chemical substances.", file: "/certs/reach.pdf" },
  { icon: "🔍", name: "SGS Audited", desc: "Third-party audited supplier — the production system is independently verified and traceable.", file: "/certs/sgs.pdf" },
  { icon: "🧪", name: "In-House Laboratory", desc: "Key indicators such as tack, holding power, peel strength and aging are tested in our own lab." },
];

const reports = [
  { name: "PE Foam Tape — RoHS Report", file: "/reports/pe-foam-rohs.pdf" },
  { name: "PET Tape — RoHS Report", file: "/reports/pet-rohs.pdf" },
  { name: "PE Foam Tape — UV Aging Test", file: "/reports/pe-foam-uv-aging.pdf" },
  { name: "Double Sided PET Tape — RoHS Report", file: "/reports/pet-tape-rohs.pdf" },
  { name: "Double Sided PE Foam Tape — RoHS Report", file: "/reports/pe-foam-tape-rohs.pdf" },
  { name: "Flame-Retardant Tissue Tape — RoHS Report", file: "/reports/flame-retardant-tissue-rohs.pdf" },
  { name: "Low-Odor Tissue Tape — Odor Test Report", file: "/reports/low-odor-tissue-odor.pdf" },
];
---

<Layout title="Certifications & Test Reports — LubandArt Tape" description="ISO 9001, RoHS, REACH, SGS audit and third-party test report downloads for LubandArt industrial adhesive tapes."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Certifications', href: '/certifications' }]}
>
  <SubHero
    eyebrow="Quality"
    title="Certifications & Test Reports"
    sub="A complete quality system and third-party test reports give you confidence in stable, long-term supply. The documents below are available for direct download."
    breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Certifications', href: '/certifications' }]}
  />

  <section class="mod mod-light">
    <div class="container">
      <div class="grid">
        {certs.map((c) => (
          <div class="card cert-card">
            <div class="ico">{c.icon}</div>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            {c.file && <a class="cert-link" href={c.file} target="_blank" rel="noopener">Download Certificate ↗</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mod mod-gray">
    <div class="container">
      <h2 class="rep-h">Test Report Downloads</h2>
      <ul class="report-list">
        {reports.map((r) => (
          <li><a href={r.file} target="_blank" rel="noopener"><span class="pdf-ico">PDF</span> {r.name}</a></li>
        ))}
      </ul>
      <p class="rep-note">Need the full TDS / SDS for a specific product, or additional third-party reports? Please <a href="/contact">contact us</a> to request them.</p>
    </div>
  </section>
</Layout>

<style>
  .page-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .5rem 0 .6rem; }
  .page-sub { color: var(--fg-soft); max-width: 640px; }
  .eyebrow { color: var(--accent); font-weight: 700; letter-spacing: 2px; font-size: .8rem; text-transform: uppercase; }
  .cert-card .ico { width: 48px; height: 48px; border-radius: 12px; background: rgba(246,130,31,.12); color: var(--accent); display: grid; place-items: center; font-size: 1.5rem; margin-bottom: 1rem; }
  .cert-link { color: var(--accent); font-weight: 600; }
  .rep-h { font-size: 1.4rem; margin: 2.5rem 0 1rem; }
  .report-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .report-list li a { display: flex; align-items: center; gap: .6rem; padding: .75rem 1rem; border: 1px solid var(--line); border-radius: 10px; color: var(--fg); font-size: .92rem; transition: border-color .2s, color .2s; }
  .report-list li a:hover { border-color: var(--accent); color: var(--accent); }
  .report-list .pdf-ico { color: var(--accent); font-weight: 700; font-size: .78rem; border: 1px solid var(--accent); border-radius: 6px; padding: 1px 6px; }
  .rep-note { margin-top: 1.5rem; color: var(--fg-soft); }
  .rep-note a { color: var(--accent); font-weight: 600; }
</style>
