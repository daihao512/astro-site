---
import Layout from '../layouts/Layout.astro';
import SubHero from '../components/SubHero.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout title="Contact & Quote — LubandArt Tape" description="Tell us about your application and specifications, and LubandArt Tape will get back to you with product recommendations and a quote shortly."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }]}
>
  <SubHero
    eyebrow="Contact"
    title="Contact & Quote"
    sub="LubandArt Tape supplies double sided tape, foam tape, and specialty tape for converters, distributors and OEMs. Tell us about your application and specifications, and we'll review the requirement and reply with product recommendations and a quote."
    breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }]}
  />

  <section class="contact" style="padding:3rem 0">
    <div class="container">
      <div class="badges">
        <span><b>✓</b> Certification documents on request</span>
        <span><b>✓</b> Product test data available</span>
        <span><b>✓</b> Custom specifications supported</span>
        <span><b>✓</b> B2B export supply</span>
        <span><b>✓</b> Sample requests welcome</span>
      </div>
    </div>
    <div class="container contact-grid">
      <div>
        <ul class="contact-info">
          <li><strong>Email:</strong> salestape@lubandart.com</li>
          <li><strong>Contact:</strong> Email or WhatsApp available on request</li>
          <li><strong>Location:</strong> Guangdong, China</li>
          <li><strong>Working Hours:</strong> Monday – Friday · Response within one working day</li>
        </ul>
        <div class="footer-social" style="margin-top:1.5rem">
          <a href="mailto:salestape@lubandart.com">Email</a>
        </div>
      </div>

      <form id="quoteForm" class="quote-form" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-trap" />
        <input type="text" name="name" placeholder="Your name *" aria-label="Your name" autocomplete="name" required />
        <input type="text" name="company" placeholder="Company name *" aria-label="Company name" autocomplete="organization" required />
        <input type="email" name="email" placeholder="Email (or use WhatsApp / phone below)" aria-label="Email address" autocomplete="email" />
        <input type="text" name="whatsapp" placeholder="WhatsApp / phone (recommended if no email)" aria-label="WhatsApp or phone number" autocomplete="tel" />
        <select name="product" class="full" aria-label="Product type" required>
          <option value="" disabled selected>Select product type *</option>
          <optgroup label="Double Sided Tape">
            <option>Double Sided Acrylic Tape</option>
            <option>Double Sided PET Tape</option>
            <option>Double Sided Tissue Tape</option>
            <option>Double Sided OPP Tape</option>
          </optgroup>
          <optgroup label="Foam Tape">
            <option>Double Sided PE Foam Tape</option>
            <option>Double Sided EVA Foam Tape</option>
            <option>Acrylic Foam Tape</option>
          </optgroup>
          <optgroup label="Specialty Tape">
            <option>Double Sided PVC Tape</option>
            <option>Flame Retardant Tape</option>
            <option>Low-Odor Tape</option>
            <option>Substrate-Free Transfer Tape</option>
            <option>Nonwoven Tape</option>
            <option>Mesh Tape</option>
          </optgroup>
          <option>Other / Custom OEM Project</option>
        </select>
        <input type="text" name="spec" placeholder="Specs & dimensions (e.g. width 10mm, thickness 0.1mm)" aria-label="Specifications and dimensions" />
        <input type="text" name="quantity" placeholder="Estimated quantity" aria-label="Estimated quantity" />
        <textarea name="message" placeholder="Describe your needs, e.g. need 0.1mm double sided tape, 10mm wide, 5,000 rolls" aria-label="Describe your requirements" class="full"></textarea>
        <button class="btn full" type="submit" id="submitBtn">Get a Quote</button>
        <p id="formStatus" class="form-status full" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
<FaqSection title="Before You Submit an Inquiry" items={[
  { q: 'What should I include in my inquiry?', a: 'Please include your company, email or WhatsApp, product type, substrate, dimensions, application, estimated quantity and any required certification.' },
  { q: 'Can I send a drawing or datasheet?', a: 'Yes. Email drawings, product photos, technical datasheets or target specifications to salestape@lubandart.com and include your inquiry details.' },
  { q: 'Can you arrange samples?', a: 'Sample requests are welcome. We confirm the sample construction and preparation time after reviewing your requirements.' },
  { q: 'When will I receive a reply?', a: 'We aim to review complete inquiries within one working day. Complex specifications may require additional confirmation from the technical team.' },
  { q: 'Which documents can be supplied?', a: 'Depending on the product and project, we can discuss TDS, SDS, RoHS, REACH, ISO and selected test reports.' },
]} />
</Layout>

<style>
  .page-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .5rem 0 .6rem; }
  .page-sub { color: var(--fg-soft); max-width: 640px; }
  .eyebrow { color: var(--accent); font-weight: 700; letter-spacing: 2px; font-size: .8rem; text-transform: uppercase; }
  .badges { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.6rem; }
  .badges span {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .82rem; font-weight: 600; color: var(--fg-soft);
    border: 1px solid var(--line); border-radius: 999px;
    padding: .38rem .85rem; background: #fff;
  }
  .badges span b { color: var(--accent); font-weight: 700; }
  .contact { background: var(--bg-2); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2.5rem; align-items: start; }
  .contact-info li { list-style: none; padding: .5rem 0; color: var(--fg-soft); }
  .contact-info strong { color: var(--fg); }
  .footer-social { display: flex; flex-wrap: wrap; gap: .6rem; }
  .footer-social a { border: 1px solid rgba(0,0,0,.14); padding: .4rem .85rem; border-radius: 999px; font-size: .82rem; color: var(--fg-soft); }
  .footer-social a:hover { border-color: var(--accent); color: var(--accent); }
  .quote-form { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
  .quote-form .full { grid-column: 1 / -1; }
  .quote-form input, .quote-form select, .quote-form textarea {
    width: 100%; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: 10px; font: inherit; background: #fff;
  }
  .quote-form textarea { min-height: 110px; resize: vertical; }
  .quote-form .btn { padding: .85rem 1rem; }
  .quote-form .btn:disabled { opacity: .6; cursor: not-allowed; }
  .form-status { margin: 0; font-size: .9rem; min-height: 1.2em; }
  .form-trap { position: absolute; left: -10000px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .form-status.ok { color: #137333; }
  .form-status.err { color: #c5221f; }
  @media (max-width: 680px) { .quote-form, .contact-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('quoteForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const status = document.getElementById('formStatus') as HTMLParagraphElement;

  const productParam = new URLSearchParams(window.location.search).get('product');
  const productMap: Record<string, string> = {
    acrylic: 'Double Sided Acrylic Tape', eva: 'Double Sided EVA Tape', opp: 'Double Sided OPP Tape',
    'pe-foam': 'Double Sided PE Foam Tape', pet: 'Double Sided PET Tape', pvc: 'Double Sided PVC Tape',
    tissue: 'Double Sided Tissue Tape', 'low-odor': 'Other / Custom', 'flame-retardant': 'Other / Custom',
    'substrate-free': 'Other / Custom', nonwoven: 'Other / Custom', mesh: 'Other / Custom', 'acrylic-foam': 'Double Sided Acrylic Tape',
  };
  if (productParam && productMap[productParam]) {
    (form.elements['product'] as HTMLSelectElement).value = productMap[productParam];
  }

  const required = [
    { name: 'name', label: 'Name' },
    { name: 'company', label: 'Company name' },
    { name: 'product', label: 'Tape type' },
  ];

  function validate() {
    for (const f of required) {
      const el = form.elements[f.name] as HTMLInputElement;
      const val = (el.value || '').trim();
      if (!val) return { ok: false, el, msg: `${f.label} is required.` };
    }
    const email = (form.elements['email'] as HTMLInputElement).value.trim();
    const phone = (form.elements['whatsapp'] as HTMLInputElement).value.trim();
    if (!email && !phone) {
      return { ok: false, el: form.elements['email'] as HTMLInputElement, msg: 'Please provide an email or WhatsApp / phone number.' };
    }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return { ok: false, el: form.elements['email'] as HTMLInputElement, msg: 'Please enter a valid email address.' };
    }
    return { ok: true };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = 'form-status full';
    status.textContent = '';
    const v = validate();
    if (!v.ok) {
      status.className = 'form-status full err';
      status.textContent = '✗ ' + v.msg;
      v.el.focus();
      return;
    }
    // A1 — capture real attribution. Never fabricate: only what the browser actually knows.
    const params = new URLSearchParams(window.location.search);
    const data: Record<string, string> = {
      ...Object.fromEntries(new FormData(form).entries()),
    } as Record<string, string>;
    const currentPath = window.location.pathname;
    data.source_url = currentPath; // page that originated the inquiry
    data.landing_url = currentPath; // V1 fallback: no session-level landing tracking yet
    data.referrer = document.referrer || ''; // '' => server treats as UNKNOWN
    data.utm_source = params.get('utm_source') || '';
    data.utm_medium = params.get('utm_medium') || '';
    data.utm_campaign = params.get('utm_campaign') || '';
    btn.disabled = true;
    btn.textContent = 'Submitting…';
    try {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: controller.signal,
      });
      window.clearTimeout(timeout);
      const out = await res.json().catch(() => ({}));
      if (res.ok && out.ok) {
        status.className = 'form-status full ok';
        if (out.degraded) {
          status.className = 'form-status full err';
        status.innerHTML = '✗ This local preview is not connected to the inquiry database yet. Please email <a href="mailto:salestape@lubandart.com">salestape@lubandart.com</a> or <a href="https://wa.me/8618064692463" target="_blank" rel="noopener noreferrer">message us on WhatsApp</a>.';
        } else {
          status.className = 'form-status full ok';
          status.textContent = '✓ We received your inquiry and will contact you soon!';
          form.reset();
        }
      } else {
        status.className = 'form-status full err';
        status.textContent = '✗ ' + (out.error || 'Submission failed. Please try again later or email us directly.');
      }
    } catch (err) {
      status.className = 'form-status full err';
      status.textContent = err instanceof DOMException && err.name === 'AbortError'
        ? '✗ The request timed out. Please email us directly.'
        : '✗ Network error. Please email us directly.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Get a Quote';
    }
  });
</script>
