# DeepSeek（/api/chat 用，密钥仅服务端，永不暴露前端）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 联系表单线索接收落点（/api/contact 用）
# 本地开发：运行中央接收器 `python -m core.api_server`（默认 8000；本机若被占用改 PORT=8077）
#   然后填 http://localhost:8077/webhook/lead
# 生产环境：填控制面部署后的真实 Webhook URL（如 https://ctrl.example.com/webhook/lead）
CRM_WEBHOOK=

# 知识库入口（/api/chat RAG 接地用）：指向中央控制面的 /kb/query
# 本地开发：运行中央接收器后填 http://localhost:8077
# 生产环境：填控制面部署后的真实 URL（如 https://ctrl.example.com）
# 留空则 /api/chat 退化为裸 DeepSeek 代理（无知识库接地）
KB_API=
