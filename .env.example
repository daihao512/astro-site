# DeepSeek（/api/chat 用，密钥仅服务端，永不暴露前端）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 联系表单线索接收落点（/api/contact 用）
# 本地开发：运行中央接收器 `python -m core.api_server`（默认 8000；本机若被占用改 PORT=8077）
#   然后填 http://localhost:8077/webhook/lead
# 生产环境：填控制面部署后的真实 Webhook URL（如 https://ctrl.example.com/webhook/lead）
CRM_WEBHOOK=
# Optional shared secret sent as X-CRM-Webhook-Secret to authenticate the receiver.
CRM_WEBHOOK_SECRET=
# Optional server-only token for controlled test inquiries (send via request header).
INQUIRY_TEST_TOKEN=

# 知识库入口（/api/chat RAG 接地用）：指向中央控制面的 /kb/query
# 本地开发：运行中央接收器后填 http://localhost:8077
# 生产环境：填控制面部署后的真实 URL（如 https://ctrl.example.com）
# 留空则 /api/chat 退化为裸 DeepSeek 代理（无知识库接地）
KB_API=

# ===== Phase A (Node22.1) Inquiry Runtime 环境变量契约 =====
# 这些变量在 Cloudflare Pages 控制台配置为「环境变量 / Secret」；本地 dev 填 .env（勿提交真实密钥）。
# 切勿将 SMTP_PASSWORD 写入源码、日志、报告或测试 JSON。

# 生产存储绑定（Cloudflare D1）。经 wrangler.toml 的 DB 绑定注入，无需在此填写。
# 本地 dev（node adapter）无此绑定，contact.ts 会降级（storage=skipped_d1_unconfigured）。

# A5 — URL Registry 解析端点（Control Plane，Phase D 提供 /api/control-plane/urls?canonical=）。
# 留空则 url_id 解析为 NULL + PENDING_REGISTRY（不猜测）。
REGISTRY_API_BASE=

# A6 — 询盘邮件通知（Mailchannels，Cloudflare 边缘原生、keyless、生产无需 SMTP 密码）。
# 原理：Cloudflare 边缘不能开 raw TCP 连阿里云 465，也无法用 Worker 中继 SMTP；
#       故 Pages Function 直接 HTTPS POST 到 api.mailchannels.net/tx/v1/send 由 Mailchannels 投递。
# 阿里云企业邮箱收件地址由 INQUIRY_NOTIFY_TO 指定；不要把第三方客户端安全密码放入这里。
#       Mailchannels 代为发信，前提是 lubandart.com 已配 SPF(必需)+DKIM(推荐)。
# 这两个值非机密（就是邮箱地址），可在 Cloudflare Pages 控制台设"变量"；代码已内置默认值，
# 不配置也能用默认地址发信。SMTP 密码不再进入生产（已移除）。
MAIL_FROM=salestape@ludandart.com
INQUIRY_NOTIFY_TO=salestape@ludandart.com

# A8 — 统一事件 Webhook（可选）。inquiry.created 始终落 D1 inquiry_events 表（真实接收端）；
# 若配置此 URL，额外扇出一份（失败不影响主链）。
INQUIRY_EVENT_WEBHOOK=
